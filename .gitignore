# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example é o TEMPLATE público (sem secrets reais) — commitar
# pra que o próximo dev/máquina saiba quais vars precisa setar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
/.claude/

/.docs/

# ─── Defensivos contra commit acidental de credenciais ──────────
# PDF de cartões dos alunos (tem senhas em texto plano).
cartoes_codigos*.pdf
codigos_anonimizacao*.pdf
# Arquivos txt com nomes sugestivos de credenciais.
credentials*.txt
senhas*.txt
*-credentials.*
# SQLite local (caso alguém futuramente use prisma com SQLite em dev).
*.db
*.db-journal
prisma/dev.db*