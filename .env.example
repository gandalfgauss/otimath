# ─── Banco (Neon Postgres via Vercel Integration) ────────────────
# Em produção, o Vercel injeta automaticamente quando você conecta o
# projeto Neon pelo dashboard. Em dev, copie a connection string do
# painel do Neon (botão "Connection details" → "Pooled connection").
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# ─── Sessão (iron-session) ────────────────────────────────────────
# Senha de 32+ chars usada pra assinar o cookie de sessão.
# Gere uma forte: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA reutilize entre projetos. Defina valor diferente em prod.
SESSION_PASSWORD="troque-por-uma-string-aleatoria-de-pelo-menos-32-chars"

# ─── Senha mestra do logout ───────────────────────────────────────
# Senha que o aluno NÃO sabe — usada pra confirmar logout (encerra a
# sequência ativa). Só você (professor) sabe.
LOGOUT_MASTER_PASSWORD="defina-no-painel-do-vercel"

# ─── Senha de acesso ao questionário pós-sequência ────────────────
# Validada server-side. Só você passa pro aluno na hora certa.
QUESTIONNAIRE_PASSWORD="defina-no-painel-do-vercel"

# ─── Senha do modo DEV (DevPanel) ─────────────────────────────────
# Validada server-side. Pra navegar livremente entre cenas em QA.
DEV_MODE_PASSWORD="defina-no-painel-do-vercel"
